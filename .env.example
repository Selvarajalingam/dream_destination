# --- Database (PRD Part II §4.3: validate environment at startup) ---
DATABASE_URL=postgres://dream:dream@localhost:5433/dream_destination
DATABASE_POOL_MAX=10

# --- Cache, jobs and rate limits. Unset falls back to an in-memory adapter. ---
REDIS_URL=redis://localhost:6380

# --- Sessions ---
# 32+ random bytes, base64. Generate: openssl rand -base64 32
SESSION_SECRET=change-me-in-every-environment-0000000000000

# --- Dream AI (optional) ---
# Unset: the app uses the deterministic brief parser and labels the degraded
# path in the UI. PRD Part II §14.2.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Maps / routing (optional) ---
# Unset: distances come from the haversine adapter, which works offline.
OSRM_BASE_URL=

# --- Booking provider (optional) ---
# Unset: a sandbox provider supplies labelled demonstration offers. Set to a
# provider's base URL to use it; it falls back to the sandbox on failure.
BOOKING_BASE_URL=

# --- Push notifications (optional) ---
# Unset: nothing is sent to devices, and the alert centre says so. Set all
# three to deliver web push. Generate a VAPID key pair with:
#   node -e "const {generateKeyPairSync}=require('node:crypto');const {publicKey,privateKey}=generateKeyPairSync('ec',{namedCurve:'prime256v1'});const j=publicKey.export({format:'jwk'});console.log('VAPID_PUBLIC_KEY='+Buffer.concat([Buffer.from([4]),Buffer.from(j.x,'base64url'),Buffer.from(j.y,'base64url')]).toString('base64url'));console.log('VAPID_PRIVATE_KEY='+privateKey.export({format:'jwk'}).d)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@dreamdestination.invalid

# Encrypts stored push subscriptions. 32 bytes, base64. Falls back to a key
# derived from SESSION_SECRET when unset.
PUSH_ENCRYPTION_KEY=

# --- Environment label. Seeded demo data is only permitted outside production. ---
APP_ENV=local

# --- Owner uploads. A directory outside public/; a pilot uses object storage. ---
UPLOAD_DIR=var/uploads
